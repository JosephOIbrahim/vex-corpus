{"id": "h21bp_6_context_specific_best_practices_016", "content": "Geometry Wrangle inside a solver: outward radial impulse.", "code_blocks": [{"code": "// Geometry Wrangle inside a solver: outward radial impulse.\n  vector dir = @P - chv(\"center\");\n  v@v += normalize(dir) * chf(\"strength\") * f@TimeInc;", "line_context": "best-practices guide", "is_complete": true}], "content_type": "pattern", "difficulty": "intermediate", "vex_context": ["solver"], "subcontext": "best_practice", "domain": "mpm", "source_id": "houdini21-best-practices", "source_url": "docs/HOUDINI21_BEST_PRACTICES.md", "source_authority": 0.9, "title": "scale impulses by `f@TimeInc`", "section": "Best Practices / 6. Context-specific best practices", "license": "MIT", "attribution": "vex-corpus maintainers -- Houdini 21 Best Practices guide (MIT)", "functions_referenced": [], "attributes_read": [], "attributes_written": [], "houdini_version_min": "21.0", "houdini_version_max": "", "houdini_version_notes": "", "prerequisites": [], "verified": false, "verification_method": "static-lint", "verified_houdini_build": "", "created_at": "2026-06-02T00:28:55.223856", "pipeline_version": "0.3.0", "checksum": "12eb2b861fca9351884088382ff6e9a89ef44e3642f9d1e204658c6b3417bda0", "prompt": "scale impulses by `f@TimeInc`", "alternative_prompts": ["mpm", "houdini 21 best practice"], "explanation": "Geometry Wrangle inside a solver: outward radial impulse.", "flagged_for_review": false, "review_reason": "", "validation_warnings": [], "llm_topic": "mpm"}
{"id": "h21bp_6_context_specific_best_practices_017", "content": "— keep it branch-light, it runs per shading sample:", "code_blocks": [{"code": "// Snippet VOP: fresnel rim. I is the incident ray; -I faces the camera.\n  float f = pow(1.0 - clamp(dot(normalize(N), normalize(-I)), 0, 1),\n                chf(\"rim_power\"));\n  Cf += f * chv(\"rim_color\");", "line_context": "best-practices guide", "is_complete": true}], "content_type": "pattern", "difficulty": "intermediate", "vex_context": ["material"], "subcontext": "best_practice", "domain": "look_development", "source_id": "houdini21-best-practices", "source_url": "docs/HOUDINI21_BEST_PRACTICES.md", "source_authority": 0.9, "title": "6.3 Look development — materials (CVEX / MaterialX / Karma)", "section": "Best Practices / 6. Context-specific best practices", "license": "MIT", "attribution": "vex-corpus maintainers -- Houdini 21 Best Practices guide (MIT)", "functions_referenced": [], "attributes_read": [], "attributes_written": [], "houdini_version_min": "21.0", "houdini_version_max": "", "houdini_version_notes": "", "prerequisites": [], "verified": false, "verification_method": "static-lint", "verified_houdini_build": "", "created_at": "2026-06-02T00:28:55.223933", "pipeline_version": "0.3.0", "checksum": "30ccbfb7c973860ddd7d70d6558b6e82fba4924f52d489b91a3434e9f12ca5e6", "prompt": "6.3 Look development — materials (CVEX / MaterialX / Karma)", "alternative_prompts": ["look development", "houdini 21 best practice"], "explanation": "— keep it branch-light, it runs per shading sample:", "flagged_for_review": false, "review_reason": "", "validation_warnings": [], "llm_topic": "look_development"}
