{"id": "h21bp_3_vex_best_practices_006", "content": "single coherent pass:", "code_blocks": [{"code": "// Detail Wrangle: lay points along X and stitch them into one polyline.\n  int prev = -1;\n  for (int i = 0; i < chi(\"count\"); i++) {\n      int pt = addpoint(0, set(i * chf(\"step\"), 0, 0));\n      if (prev >= 0) {\n          int pr = addprim(0, \"polyline\");\n          addvertex(0, pr, prev);\n          addvertex(0, pr, pt);\n      }\n      prev = pt;\n  }", "line_context": "best-practices guide", "is_complete": true}], "content_type": "pattern", "difficulty": "intermediate", "vex_context": ["sop"], "subcontext": "best_practice", "domain": "fundamentals", "source_id": "houdini21-best-practices", "source_url": "docs/HOUDINI21_BEST_PRACTICES.md", "source_authority": 0.9, "title": "Editing geometry", "section": "Best Practices / 3. VEX best practices", "license": "MIT", "attribution": "vex-corpus maintainers -- Houdini 21 Best Practices guide (MIT)", "functions_referenced": [], "attributes_read": [], "attributes_written": [], "houdini_version_min": "21.0", "houdini_version_max": "", "houdini_version_notes": "", "prerequisites": [], "verified": false, "verification_method": "static-lint", "verified_houdini_build": "", "created_at": "2026-06-02T00:28:55.223201", "pipeline_version": "0.3.0", "checksum": "133a06c724968b61d04273c0a23f8a3468ff4297bc963d94a416c3ac74143261", "prompt": "Editing geometry", "alternative_prompts": ["fundamentals", "houdini 21 best practice"], "explanation": "single coherent pass:", "flagged_for_review": false, "review_reason": "", "validation_warnings": [], "llm_topic": "best_practices"}
